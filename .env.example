APP_BIND_ADDR=127.0.0.1:3000
APP_DATABASE_URL=sqlite://./audiobooks_downloader.db
APP_STORAGE_ROOT=./storage
APP_API_KEY=change-this-local-key
APP_DOWNLOAD_TTL_SECS=86400
APP_CLEANUP_INTERVAL_SECS=60
# Optional limits
MAX_CONCURRENT_DOWNLOADS=3
METADATA_TIMEOUT_SECS=600
NO_PROGRESS_TIMEOUT_SECS=600
# MAX_TORRENT_BYTES=10737418240
# Comma-separated tracker hosts; when set, all other tr= trackers are dropped.
# TRACKER_ALLOWLIST=tracker.example.org
